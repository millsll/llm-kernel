CompileFlags:
    CompilationDatabase: build/
    Add:
        - -xcuda
        - --cuda-path=/usr/local/cuda-13.0
        - --cuda-gpu-arch=sm_100
        - -I../include
        - -I../../../../third_party/flashinfer/include
        - -I../../../../third_party/flashinfer/3rdparty/cccl/libcudacxx/include
        - -I../../../../third_party/flashinfer/3rdparty/cutlass/include
        - -isystem/usr/local/cuda-13.0/targets/x86_64-linux/include
        - -isystem/usr/local/cuda-13.0/targets/x86_64-linux/include/cccl
